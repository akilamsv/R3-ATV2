<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="multiplo de 5 flow"/>
        <attribute name="authors" value="DES-I1HS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-07 02:34:51 "/>
        <attribute name="created" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMDE6NTc6MzYgIjsyNjQ2"/>
        <attribute name="edited" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMDI6MzQ6NTEgIjsxOzI3NDc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="vari&#225;vel numero ir&#225; amarzenar o n&#250;mero inserido pelo usu&#225;rio"/>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero:&quot;" newline="True"/>
            <input variable="numero"/>
            <comment text="SE ir&#225; armazenar a equa&#231;&#227;o pra saber se o n&#250;mero &#233; m&#250;ltiplo de 5 (n%5), se o resultado for 0, &#233; multiplo, se sobrar n&#250;mero n&#227;o &#233;"/>
            <if expression="numero%5 = 0">
                <then>
                    <output expression="&quot;Este n&#250;mero &#233; m&#250;ltiplo de 5.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Este n&#250;mero n&#227;o &#233; m&#250;ltiplo de 5&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
