<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="num&#233;ro positivo flkow"/>
        <attribute name="authors" value="DES-I1HS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-07 01:10:53 "/>
        <attribute name="created" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMTI6MzI6MTYgIjsyNjM5"/>
        <attribute name="edited" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMDE6MTA6NTMgIjsyOzI3NDM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="vari&#225;vel n&#250;mero ir&#225; armazenar n&#250;mero negativo ou positivo dependendo do n&#250;mero inserido pelo usuario&#13;&#10;"/>
            <declare name="numero" type="Real" array="False" size=""/>
            <output expression="&quot;insira um n&#250;mero&quot;" newline="True"/>
            <input variable="numero"/>
            <comment text="SE ir&#225; armazenar a equa&#231;&#227;o para descobrir se o n&#250;mero inserido &#233; negativo ou positivo"/>
            <if expression="numero &lt; 0">
                <then>
                    <output expression="&quot;Este n&#250;mero &#233; negativo&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Este n&#250;mero &#233; positivo&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
