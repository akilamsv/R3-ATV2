        <attribute name="created" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMDE6MDg6NTEgIjsyNjM5"/>
        <attribute name="edited" value="REVTLUkxSFM7RVNONTEyTjlOVEI3NzQ7MjAyNS0wNC0wNzsiMDE6MTU6MzggIjsxOzI3NTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="A variavel numIdade armazenar&#225; a idade inserida pelo usuario"/>
            <declare name="numIdade" type="Integer" array="False" size=""/>
            <output expression="&quot;Informe sua idade&quot;" newline="True"/>
            <input variable="numIdade"/>
            <comment text="SE ir&#225; armazenar a equa&#231;&#227;o para diferenciar menor de 18 entre maior de 18"/>
            <if expression="numIdade &gt; 18">
                <then>
                    <output expression="&quot;Voc&#234; &#233; maior de idade!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Voc&#234; &#233; menor de idade!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
